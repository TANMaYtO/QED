{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QEDCertificate",
  "description": "Schema for QED mathematical discovery and verification certificates.",
  "type": "object",
  "required": [
    "schema_version",
    "problem_id",
    "problem_spec_sha256",
    "claim_type",
    "construction",
    "claimed_score",
    "best_known",
    "best_known_tolerance",
    "run",
    "verifiers",
    "created_at",
    "certificate_sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "problem_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "problem_spec_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "claim_type": {
      "type": "string",
      "enum": ["demonstration", "reproduction", "record"]
    },
    "construction": {
      "type": "object",
      "required": ["centers", "radii"],
      "additionalProperties": false,
      "properties": {
        "centers": {
          "type": "array",
          "minItems": 26,
          "maxItems": 26,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string",
              "maxLength": 100
            }
          }
        },
        "radii": {
          "type": "array",
          "minItems": 26,
          "maxItems": 26,
          "items": {
            "type": "string",
            "maxLength": 100
          }
        }
      }
    },
    "claimed_score": {
      "type": "string",
      "pattern": "^[0-9]+/[1-9][0-9]*$"
    },
    "best_known": {
      "type": ["object", "null"],
      "required": ["value", "source_url", "retrieved_date"],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "string",
          "maxLength": 100
        },
        "source_url": {
          "type": "string"
        },
        "retrieved_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "best_known_tolerance": {
      "type": ["string", "null"],
      "pattern": "^[0-9]+/[1-9][0-9]*$"
    },
    "run": {
      "type": ["object", "null"],
      "required": [
        "run_id",
        "engine",
        "engine_version",
        "model",
        "iterations",
        "best_fast_score",
        "shrink_loss_exact"
      ],
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "type": "string"
        },
        "engine": {
          "type": "string"
        },
        "engine_version": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "iterations": {
          "type": "integer",
          "minimum": 0
        },
        "best_fast_score": {
          "type": "string"
        },
        "shrink_loss_exact": {
          "type": "string"
        }
      }
    },
    "verifiers": {
      "type": "object",
      "required": ["exact_sha256", "independent_sha256"],
      "additionalProperties": false,
      "properties": {
        "exact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "independent_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "created_at": {
      "type": "string"
    },
    "certificate_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "claim_type": {
            "const": "demonstration"
          }
        }
      },
      "then": {
        "properties": {
          "best_known": {
            "type": "null"
          },
          "best_known_tolerance": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "claim_type": {
            "const": "reproduction"
          }
        }
      },
      "then": {
        "properties": {
          "best_known": {
            "type": "object"
          },
          "best_known_tolerance": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "claim_type": {
            "const": "record"
          }
        }
      },
      "then": {
        "properties": {
          "best_known": {
            "type": "object"
          },
          "best_known_tolerance": {
            "type": "null"
          }
        }
      }
    }
  ]
}
